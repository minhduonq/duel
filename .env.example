# Copy to .env. run_duels.py and vast.py read it at start (real environment variables win).

# OpenAI-compatible endpoint serving GLM-4.6V-Flash. With `python vast.py tunnel` running, GLM on the
# vast.ai instance answers here on 127.0.0.1.
GLM_BASE_URL=http://127.0.0.1:8002/v1
GLM_API_KEY=EMPTY
GLM_MODEL=glm-4.6v-flash

# vast.ai instance: its SSH command exactly as the console shows it (or `vastai ssh-url <id>`)
VAST_SSH=ssh -p 41234 root@ssh4.vast.ai -L 8080:localhost:8080
# Private key whose .pub is registered at vast.ai (default ~/.ssh/id_ed25519)
# VAST_KEY=~/.ssh/id_ed25519
# Port of vLLM on the instance and of the local tunnel end
GLM_PORT=8002
# GLM_MAX_MODEL_LEN=32768

# render-service-js (AI-3D-Generation/render-service-js): `PORT=8000 node src/server.js`, or the pinned Docker image.
# A comma-separated list spreads renders over several services, e.g. the copies `python vast.py render` starts:
# RENDERER_URL=http://127.0.0.1:8101,http://127.0.0.1:8102,http://127.0.0.1:8103,http://127.0.0.1:8104,http://127.0.0.1:8105,http://127.0.0.1:8106,http://127.0.0.1:8107,http://127.0.0.1:8108
RENDERER_URL=http://127.0.0.1:8000
# `python vast.py render`: renderer copies on the instance (forwarded by `tunnel`) and the local service checkout
RENDER_INSTANCES=8
# RENDER_BASE_PORT=8101
# RENDER_SERVICE_DIR=../AI-3D-Generation/render-service-js

# Only needed if the DINOv3 mirror ever becomes gated
# HF_TOKEN=
